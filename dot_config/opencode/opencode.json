{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "share": "manual",
  "snapshot": true,
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "ask",
    "external_directory": "ask",
    "todowrite": "allow",

    // Web & Network Access
    "webfetch": "allow",
    "websearch": "allow",

    // Agent Capabilities
    "task": "allow",
    "skill": "allow",

    // Search & Introspection
    "glob": "allow",
    "grep": "allow",
    "list": "allow",

    // MCP tools are opt-in per specialist agent
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "playwright_*": "deny",

    // Interaction & Safety
    "question": "allow",
    "doom_loop": "ask",
    "lsp": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true,
      "timeout": 10000
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.78",
        "--executable-path",
        "/usr/bin/chromium"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".gradle/**",
      "target/**",
      ".idea/**",
      ".kotlin/**",
      ".fleet/**",
      ".run/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "lsp": true,
  "instructions": [
    "./tools/philosophy.md"
  ],
  "plugin": [
    "opencode-models-discovery@1.2.0",
    "@tarquinen/opencode-dcp@3.1.3",
    "@franlol/opencode-md-table-formatter@0.0.6",
    "@slkiser/opencode-quota@4.5.0"
  ],
  "disabled_providers": [],
  "provider": {
    "llama.cpp": {
      "name": "llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:LLAMA_CPP_URL}",
        "modelsDiscovery": {
          "enabled": true,
          "endpoint": "/v1/models",
          "smartModelName": true
        }
      },
      "models": {}
    }
  }
}
